# Virtual environments
.venv/
venv/
env/

# External binaries — Morpheus's mpv.exe / yt-dlp.exe live here, uncommitted
bin/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/

# Secrets — never commit (.env.example is the committed template)
.env

# Runtime state & data (machine-local, not source)
*.log
# RotatingFileHandler backups: felhaven.log.1, .log.2, ... (*.log misses these)
*.log.[0-9]*
*.tmp
scribe_data.json
timer_state.json
felhaven_data.json
felhaven_settings.json
plutus_ledger.json
# Euterpe — the song ledger (what music has played). Generated and
# personal, same bucket as plutus_ledger.json; config/euterpe_config.json
# is the committed tuning template and STAYS tracked.
#
# Globbed, not the bare name: the TUNES editor writes euterpe_ledger.json.bak
# beside it on every hand edit, and a repair leaves a dated copy of the same
# shape. One pattern covers the log and everything that is a copy of it, so
# `git add -A` can never stage somebody's listening history.
euterpe_ledger.json*
argus_timeline.json
morpheus_playlists.json
morpheus_watch_later/
# Artemis waypoints — config SHAPE, personal CONTENT (where you camp, hunt or
# work). Same bucket as morpheus_playlists.json.
artemis_waypoints.json
machine_spirit_config.json
# Voices — which kokoro voice Pythia narrates in (voices.py). Per-user.
voice_config.json
# Pheme — which stories have been clicked through (tools/pheme.py) and which
# Source Fonts sections were left open (panels/pheme_panel.py). Per-user.
pheme_read.json
pheme_sections.json

# Cerberus & Sphynx — per-user PIN files + encrypted state, all machine-local.
# The PIN-hash files are no longer shipped: first-run onboarding writes them, so
# a fresh clone has none and the in-app setup triggers instead of inheriting the
# author's PINs. cerberus_manifest.json (the config-list template) STAYS
# committed. The vault holds ciphertext; the ledger holds key/file names + ts.
sphynx_data.json
cerberus_data.json
cerberus_vault.json
cerberus_ledger.json

# Herodotus — the Markdown knowledge archive. Personal state, not source.
herodotus_archive/

# Artemis — the local-chart cache (downloaded map data around the user's fix,
# incl. the _reference/ county index). Machine-local state, rebuilt by ingest;
# also where your home coordinates would leak from, so never committed.
artemis_cache/

# Calliope — kokoro-onnx model binaries (voices-v1.0.bin + kokoro-v1.0*.onnx),
# ~350 MB. Downloaded separately; see SETUP.md section 4.
kokoro_models/

# Echo — generated .opus audio files (text → audio). Runtime output, not source;
# same bucket as morpheus_watch_later/. No retention cap by design.
local_audio/

# Personal design / idea notes (kept local, not source of record)
specs/felhaven_design_v01.md

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Editor / tool-local config (Claude Code per-user permission allowlist) — at
# any depth, since a nested metis_toolbox/.claude/ copy exists too.
**/.claude/settings.local.json
